# --- environment / secrets: API keys live in .env.* files, NEVER commit ---
.env.*
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- work products: never commit renders or intermediates ---
*.mp4
*.mov
*.wav
rough*.mov
mixed.wav
seg/
pills/
verify_frames/
work/

# --- third-party media: licensing is per-user, not per-repo ---
# NO audio ships in the repo. Mixkit's free licence covers USING a track in
# your video, not redistributing the file itself — so every user downloads
# their own copies (see bgm-library/README.md). Anything downloaded for a
# specific project (commercial songs, official B-roll) also stays out.
skills/yiibu/bgm-library/**/*.mp3
skills/yiibu/bgm-library/**/*.m4a
skills/yiibu/bgm-library/**/*.wav
skills/yiibu/sfx-library/*.mp3
skills/yiibu/sfx-library/*.wav
bgm/
skills/yiibu/assets/downloaded/
cover_src/

# --- os ---
.DS_Store

# --- personal assets: keep working locally, never publish ---
skills/yiibu/assets/substack.png
skills/yiibu/keyword_bank.local.json

